# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.ruff_cache/
.benchmarks/
.mypy_cache/

# Generated model output
*.xlsx
!configs/*.xlsx
# corefin run/optimize/simulate default their chart/workbook output paths to
# the current working directory -- ignore stray PNGs written to the repo
# root, but keep docs/simulate/*.png (embedded in the README) tracked; the
# root-anchored pattern below never matches that subdirectory anyway.
/*.png

# OS files
.DS_Store
Thumbs.db

# Credit-loss forecasting engine: raw downloads and processed panels --
# never commit real Call Report / FRED / Fed-scenario data or API keys.
/data/

# Bank M&A simulator: a LOCAL override for configs/example_bank_deal.yaml's
# acquirer/target RSSD IDs, for anyone adapting this example to their own
# (possibly sensitive) real deal -- never committed. The checked-in
# .template file (placeholders only) is explicitly kept, below.
/configs/local/*.yaml
!/configs/local/*.yaml.template
